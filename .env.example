# ==============================================================================
# UniFinder AI Environment Configuration
# ==============================================================================

# Option 1: Google Gemini (Recommended - Free Tier from Google AI Studio)
# Generate free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Option 2: Groq Cloud (Alternative - Ultra Fast Free Tier with Llama-3.3 70B)
# Generate free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option 3: Cerebras Inference (1M Free Tokens/Day - Llama 3.3 70B)
# Generate free at: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Option 4: OpenRouter (Free ":free" Models - Llama 3.3, Gemma 3, DeepSeek R1)
# Generate free at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 5: Mistral AI (Free Experiment Tier)
# Generate free at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Option 6: SambaNova Cloud (Free Fast Llama 3.3 70B)
# Generate free at: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Optional: LangSmith Observability & Agent Tracing
# Sign up free at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=unifinder-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Server Hosting Configuration
PORT=8000
HOST=127.0.0.1
