# ==============================================================================
# UniFinder AI Environment Configuration
# ==============================================================================

# Option 1: Google Gemini (Recommended - Free Tier from Google AI Studio)
# Generate free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Option 2: Groq Cloud (Ultra Fast Free Tier - No Card Needed)
# Generate free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option 3: Mistral AI (Free Experiment Tier - No Card Needed)
# Generate free at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Option 4: Cohere (Free Trial API - 1,000 calls/month, No Card Needed)
# Generate free at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Optional: LangSmith Observability & Agent Tracing
# Sign up free at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=unifinder-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Server Hosting Configuration
PORT=8000
HOST=127.0.0.1
